<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Lexicon"
        android:supportsRtl="true">

        <activity
            android:name=".ui.hub.HubActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.practice.PracticeActivity"
            android:exported="false"
            android:label="@string/practice_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.realm.RealmSelectActivity"
            android:exported="false"
            android:label="@string/realm_select_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.map.DungeonMapActivity"
            android:exported="false"
            android:label="@string/dungeon_map_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.battle.BattleActivity"
            android:exported="false"
            android:label="@string/battle_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reward.RewardActivity"
            android:exported="false"
            android:label="@string/reward_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.stats.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.library.LibraryActivity"
            android:exported="false"
            android:label="@string/library_title"
            android:screenOrientation="portrait" />

    </application>

</manifest>
