<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Map generation only. The key lives on the proxy, never in this APK. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed only on API 33+ (Android 13), where notifications became a runtime permission.
         Declaring it is harmless below 33; SettingsActivity requests it on the reminder
         toggle, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- AlarmManager schedules do not survive a reboot; BootReceiver re-arms them. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Lexicon"
        android:supportsRtl="true">

        <activity
            android:name=".ui.hub.HubActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.practice.PracticeActivity"
            android:exported="false"
            android:label="@string/practice_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.realm.RealmSelectActivity"
            android:exported="false"
            android:label="@string/realm_select_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.map.DungeonMapActivity"
            android:exported="false"
            android:label="@string/dungeon_map_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.battle.BattleActivity"
            android:exported="false"
            android:label="@string/battle_title"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.reward.RewardActivity"
            android:exported="false"
            android:label="@string/reward_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.reward.SpoilsActivity"
            android:exported="false"
            android:label="@string/spoils_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.shop.ShopActivity"
            android:exported="false"
            android:label="@string/shop_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.stats.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.library.LibraryActivity"
            android:exported="false"
            android:label="@string/library_title"
            android:screenOrientation="portrait" />

        <!-- notify/ (P4-5). Neither is exported: the alarm receiver is only ever triggered by
             our own PendingIntent, and BootReceiver only by the system broadcast. -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false" />

        <!-- Exported because ACTION_BOOT_COMPLETED comes from the system, and a non-exported
             receiver would never see it. RECEIVE_BOOT_COMPLETED is what gates it. -->
        <receiver
            android:name=".notify.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
