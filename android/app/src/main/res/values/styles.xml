        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">@dimen/text_mono</item>
    </style>

    <style name="TextAppearance.Lexicon.Dim" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/mono_font_family</item>
        <item name="android:fontFamily">@font/mono_font_family</item>
        <item name="android:textColor">@color/fg_dim</item>
