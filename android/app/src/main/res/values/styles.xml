        <item name="android:fontFamily">@font/mono_font_family</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Lexicon.Body" parent="TextAppearance.Material3.BodyLarge">
