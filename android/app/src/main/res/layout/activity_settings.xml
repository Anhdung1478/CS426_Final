<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Lexicon.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/settings_cefr_label"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <Spinner
            android:id="@+id/cefrSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/settings_locale_label"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <Spinner
            android:id="@+id/localeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/timerFullLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <SeekBar
            android:id="@+id/timerFullSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/timerPartialLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <SeekBar
            android:id="@+id/timerPartialSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- P4-6: daily review reminder. The permission request fires on the toggle, never at
             launch — see SettingsActivity. -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/reminderSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="48dp"
            android:text="@string/settings_reminder_label"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <TextView
            android:id="@+id/reminderHourLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <Spinner
            android:id="@+id/reminderHourSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/reminderBlockedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_reminder_blocked"
            android:textAppearance="@style/TextAppearance.Lexicon.Dim"
            android:visibility="gone" />

        <Button
            android:id="@+id/reminderSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:minHeight="48dp"
            android:text="@string/settings_reminder_open_settings"
            android:visibility="gone" />

        <Button
            android:id="@+id/replayIntroButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:minHeight="48dp"
            android:text="@string/settings_replay_intro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/settings_map_api_label"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <EditText
            android:id="@+id/mapApiUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:hint="@string/settings_map_api_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/settings_map_api_help"
            android:textAppearance="@style/TextAppearance.Lexicon.Body" />

    </LinearLayout>
</ScrollView>
